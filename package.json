{
  "name": "never-ending-pasta-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:subpath": "BASE_PATH=/agent-sandbox/ vite",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/agent-sandbox/ npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:pages": "BASE_PATH=/agent-sandbox/ vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite-plugin-pwa": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "oxlint": "1.74.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
